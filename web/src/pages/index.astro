---
import '../styles/agri-swiss.css';
import DroughtWorkbench from '../components/DroughtWorkbench.svelte';
---

<!doctype html>
<html lang="id" data-theme="kertas">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kekeringan &amp; PDLVI Jawa Tengah — Agri Transbulent</title>
    <link rel="preload" href="/kekeringan/fonts/OverusedGrotesk-VF.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/kekeringan/fonts/IBMPlexMono-400.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try {
        var t = localStorage.getItem('agri_theme');
        if (t === 'malam' || t === 'kertas') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <DroughtWorkbench client:only="svelte" />
  </body>
</html>
